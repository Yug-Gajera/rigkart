# SerpApi key — https://serpapi.com/manage-api-key
# Only needed when DEMO_MODE=false. Free tier: 250 searches/month.
SERPAPI_KEY=

# true  -> serve committed fixtures in fixtures/, zero API credits used
# false -> real SerpApi calls (cached in Postgres, so each query costs 1 credit once)
DEMO_MODE=true

# Supabase project -> Settings > API. Service role key, server-side only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
